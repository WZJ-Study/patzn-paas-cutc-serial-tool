                            <font>
                                <Font name="Microsoft YaHei UI" size="18.0"/>
                            </font>
                        </CheckBox>
                        <Label minHeight="32.0" text="SlaveID：" textFill="WHITE">
                            <font>
                                <Font name="Microsoft YaHei UI" size="18.0"/>
                            </font>
                        </Label>
                        <TextField fx:id="slaveIdInput6" prefHeight="32.0" prefWidth="120"
                                   promptText="取值范围：1 to 255"/>

                        <Label minHeight="32.0" text="Address：" textFill="WHITE">
                            <font>
                                <Font name="Microsoft YaHei UI" size="18.0"/>
                            </font>
                        </Label>
                        <TextField fx:id="listeningAddressInput6" prefHeight="32.0" prefWidth="120"
