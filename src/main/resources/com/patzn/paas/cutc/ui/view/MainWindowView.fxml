                            </font>
                        </Label>
                        <ChoiceBox fx:id="dataTypeInput3" prefHeight="32.0" prefWidth="200"/>
                    </children>
                    <padding>
                        <Insets left="10.0" right="10.0"/>
                    </padding>
                </HBox>

                <HBox alignment="CENTER_LEFT" maxHeight="50.0" minHeight="50.0" spacing="10.0" styleClass="settingsRow">
                    <children>
                        <CheckBox fx:id="listeningAddressEnabledInput4" mnemonicParsing="false" text="4#"
                                  textFill="WHITE">
                            <font>
                                <Font name="Microsoft YaHei UI" size="18.0"/>
