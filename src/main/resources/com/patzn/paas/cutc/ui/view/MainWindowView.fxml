                        </Label>
                        <ChoiceBox fx:id="functionTypeInput2" prefHeight="32.0" prefWidth="200"/>

                        <Label minHeight="32.0" text="DataType：" textFill="WHITE">
                            <font>
                                <Font name="Microsoft YaHei UI" size="18.0"/>
                            </font>
                        </Label>
                        <ChoiceBox fx:id="dataTypeInput2" prefHeight="32.0" prefWidth="200"/>
                    </children>
                    <padding>
                        <Insets left="10.0" right="10.0"/>
                    </padding>
                </HBox>

                <HBox alignment="CENTER_LEFT" maxHeight="50.0" minHeight="50.0" spacing="10.0" styleClass="settingsRow">
                    <children>
                        <CheckBox fx:id="listeningAddressEnabledInput3" mnemonicParsing="false" text="3#"
                                  textFill="WHITE">
                            <font>
                                <Font name="Microsoft YaHei UI" size="18.0"/>
                            </font>
                        </CheckBox>
                        <Label minHeight="32.0" text="SlaveID：" textFill="WHITE">
                            <font>
                                <Font name="Microsoft YaHei UI" size="18.0"/>
                            </font>
                        </Label>
                        <TextField fx:id="slaveIdInput3" prefHeight="32.0" prefWidth="120"
