                            <font>
                                <Font name="Microsoft YaHei UI" size="18.0"/>
                            </font>
                        </CheckBox>
                        <Label minHeight="32.0" text="SlaveID：" textFill="WHITE">
                            <font>
                                <Font name="Microsoft YaHei UI" size="18.0"/>
                            </font>
                        </Label>
                        <TextField fx:id="slaveIdInput2" prefHeight="32.0" prefWidth="120"
