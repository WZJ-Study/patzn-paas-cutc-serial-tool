                <Separator prefWidth="200.0"/>
                <HBox alignment="CENTER_LEFT" maxHeight="50.0" minHeight="50.0" spacing="10.0" styleClass="settingsRow">
                    <children>
                        <Label minHeight="32.0" text="定时采集间隔（秒）" textFill="WHITE">
                            <font>
                                <Font name="Microsoft YaHei UI" size="18.0"/>
                            </font>
                        </Label>
                        <TextField fx:id="intervalSecondsInput" prefHeight="32.0" prefWidth="120"
                                   promptText="请输入正整数"/>
                        <Label minHeight="32.0" text="（取值：1~300，默认：5）" textFill="WHITE">
                            <font>
                                <Font name="Microsoft YaHei UI" size="18.0"/>
                            </font>
                        </Label>
                    </children>
